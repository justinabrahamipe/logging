{
  "expo": {
    "name": "Grind Console",
    "slug": "grind-console-mobile",
    "version": "1.0.0",
    "scheme": "grindconsole",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.grindconsole.mobile"
    },
    "android": {
      "package": "com.grindconsole.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1d394d",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-font",
      ["react-native-android-widget", {
        "widgets": [{
          "name": "TaskWidget",
          "label": "Grind Console Tasks",
          "description": "Today's to-do and overdue tasks",
          "minWidth": "250dp",
          "minHeight": "180dp",
          "targetCellWidth": 4,
          "targetCellHeight": 3,
          "maxResizeWidth": "500dp",
          "maxResizeHeight": "900dp",
          "resizeMode": "horizontal|vertical",
          "updatePeriodMillis": 1800000
        }, {
          "name": "LogWidget",
          "label": "Grind Console Quick Log",
          "description": "Jump straight to typing a log entry",
          "minWidth": "180dp",
          "minHeight": "110dp",
          "targetCellWidth": 3,
          "targetCellHeight": 2,
          "maxResizeWidth": "500dp",
          "maxResizeHeight": "500dp",
          "resizeMode": "horizontal|vertical",
          "updatePeriodMillis": 0
        }]
      }]
    ],
    "extra": {
      "eas": {
        "projectId": "50c7f272-3070-44fb-aa32-553c57e22757"
      }
    },
    "owner": "justinabrahamipe"
  }
}
